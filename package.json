{
  "name": "@parlajs/root",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest --run",
    "test:coverage": "vitest --run --config vitest.config.coverage.ts",
    "bench": "vitest bench --run --config vitest.config.bench.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run site:catalogs && oxlint",
    "lint:ci": "pnpm run site:catalogs && oxlint --format=github",
    "lint:fix": "pnpm run site:catalogs && oxlint --fix",
    "lint:knip": "knip",
    "lint:publish": "pnpm -r --filter \"./packages/*\" run lint:publish",
    "lint:lib-check": "node scripts/lib-check.ts",
    "typecheck": "pnpm run build:packages && pnpm -r --filter \"./packages/*\" run typecheck && pnpm --filter @parlajs/site run typecheck && tsc -p tsconfig.scripts.json",
    "site:catalogs": "pnpm --filter @parlajs/site run catalogs",
    "site:dev": "pnpm run build:packages && pnpm --filter @parlajs/site run dev",
    "site:build": "pnpm run build:packages && pnpm --filter @parlajs/site run build",
    "validate": "node scripts/validate.ts",
    "pack:all": "pnpm run build:packages && rm -rf .packs && pnpm -r --filter \"./packages/*\" exec pnpm pack --pack-destination ../../.packs",
    "release": "pnpm run build:packages && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@marcalexiei/oxfmt-config": "2.0.1",
    "@marcalexiei/oxlint-config": "1.9.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "catalog:default",
    "knip": "6.45.1",
    "lefthook": "2.2.1",
    "oxfmt": "catalog:default",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "catalog:default"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
