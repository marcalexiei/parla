{
  "name": "@parlajs/root",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build",
    "test": "vitest --run",
    "test:coverage": "vitest --run --config vitest.config.coverage.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:ci": "oxlint --format=github",
    "lint:fix": "oxlint --fix",
    "lint:knip": "knip",
    "lint:publish": "pnpm -r --filter \"./packages/*\" run lint:publish",
    "typecheck": "pnpm run build:packages && pnpm -r --filter \"./packages/*\" run typecheck && tsc -p tsconfig.scripts.json",
    "check-all": "node scripts/check-all.ts",
    "pack:all": "pnpm run build:packages && rm -rf .packs && pnpm -r --filter \"./packages/*\" exec pnpm pack --pack-destination ../../.packs",
    "release": "pnpm run build:packages && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@marcalexiei/oxfmt-config": "2.0.1",
    "@marcalexiei/oxlint-config": "1.9.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "catalog:default",
    "knip": "6.45.1",
    "lefthook": "2.2.1",
    "oxfmt": "catalog:default",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "catalog:default"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
