{
  "name": "@parlajs/x18n-plugin",
  "version": "0.0.0",
  "description": "x18n plugin for Parla: catalogs from parla.config.ts, t.ns.key usages, ICU and MF2 params.",
  "keywords": [
    "i18n",
    "parla",
    "x18n"
  ],
  "homepage": "https://github.com/marcalexiei/parla",
  "bugs": {
    "url": "https://github.com/marcalexiei/parla/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Marco Pasqualetti",
    "url": "https://github.com/marcalexiei"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcalexiei/parla.git",
    "directory": "packages/x18n-plugin"
  },
  "files": [
    "build",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@parlajs/source": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "lint:publish": "attw --pack . --profile esm-only && publint --strict",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@parlajs/compiler": "workspace:^",
    "oxc-parser": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@x18n/core": "0.1.14",
    "vitest": "catalog:default"
  },
  "peerDependencies": {
    "@x18n/core": "^0.1.14"
  },
  "engines": {
    "node": "^24 || >=26"
  }
}
