{
  "name": "@parlajs/core",
  "version": "0.0.0",
  "description": "Framework-agnostic runtime for Parla: locale state, lazy catalogs, formatting.",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "messageformat",
    "type-safe"
  ],
  "homepage": "https://github.com/marcalexiei/parla",
  "bugs": {
    "url": "https://github.com/marcalexiei/parla/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Marco Pasqualetti",
    "url": "https://github.com/marcalexiei"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcalexiei/parla.git",
    "directory": "packages/core"
  },
  "files": [
    "build",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@parlajs/source": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "lint:publish": "attw --pack . --profile esm-only && publint --strict",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "vitest": "catalog:default"
  },
  "engines": {
    "node": "^24 || >=26"
  }
}
